{
  "name": "broker-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22.23.2 <23" },
  "scripts": {
    "env:setup": "node scripts/setup.mjs",
    "env:check": "node scripts/doctor.mjs",
    "db:install": "node scripts/postgres.mjs install",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "db:check": "node scripts/doctor.mjs --database",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run.mjs migrate",
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "worker": "node scripts/run.mjs worker",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:api": "node scripts/run.mjs test-api",
    "test:e2e": "node scripts/run.mjs test-e2e",
    "test:environment": "node scripts/run.mjs test-environment",
    "browser:install": "node scripts/run.mjs browser-install",
    "check": "pnpm typecheck && pnpm test:unit",
    "verify:environment": "pnpm check && pnpm test:environment",
    "compose:check": "docker compose --env-file .env.compose.local -f deploy/compose.yaml config --quiet",
    "compose:up": "docker compose --env-file .env.compose.local -f deploy/compose.yaml up -d --build postgres web worker",
    "compose:test": "docker compose --env-file .env.compose.local -f deploy/compose.yaml run --build --rm test",
    "compose:stop": "docker compose --env-file .env.compose.local -f deploy/compose.yaml stop"
  },
  "dependencies": {
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
