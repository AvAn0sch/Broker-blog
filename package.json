{
  "name": "broker-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "env:setup": "node scripts/setup.mjs",
    "env:check": "node scripts/doctor.mjs",
    "db:install": "node scripts/postgres.mjs install",
    "db:start": "node scripts/postgres.mjs start",
    "db:stop": "node scripts/postgres.mjs stop",
    "db:check": "node scripts/doctor.mjs --database",
    "db:generate": "node scripts/generate.mjs",
    "db:migrate": "node scripts/run.mjs migrate",
    "db:seed": "node scripts/run.mjs seed",
    "accounts:init-admin": "node scripts/run.mjs accounts init-admin",
    "accounts:reset-password": "node scripts/run.mjs accounts reset-password",
    "jobs:probe": "node scripts/run.mjs jobs probe",
    "jobs:status": "node scripts/run.mjs jobs status",
    "jobs:retry": "node scripts/run.mjs jobs retry",
    "media:recover": "node scripts/run.mjs media recover",
    "media:cleanup": "node scripts/run.mjs media cleanup",
    "media:verify": "node scripts/run.mjs media verify",
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "worker": "node scripts/run.mjs worker",
    "worker:once": "node scripts/run.mjs worker-once",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:api": "node scripts/run.mjs test-api",
    "test:e2e": "node scripts/run.mjs test-e2e",
    "test:environment": "node scripts/run.mjs test-environment",
    "test:foundation": "node scripts/run.mjs test-foundation",
    "test:auth": "node scripts/run.mjs test-auth",
    "verify:auth": "pnpm check && pnpm test:environment",
    "test:cleanup": "node scripts/run.mjs test-cleanup",
    "verify:foundation": "pnpm check && pnpm test:environment",
    "browser:install": "node scripts/run.mjs browser-install",
    "check": "pnpm typecheck && pnpm test:unit",
    "verify:environment": "pnpm check && pnpm test:environment",
    "compose:check": "node scripts/compose.mjs check",
    "compose:up": "node scripts/compose.mjs up",
    "compose:test": "node scripts/compose.mjs test",
    "compose:stop": "node scripts/compose.mjs stop"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
