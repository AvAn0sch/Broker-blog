# Run pnpm env:setup to create private local files with random credentials.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://broker_app:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/broker_blog
DATABASE_SCHEMA=public
MEDIA_ROOT=.local/media/development
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CAPTCHA_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PG_BIN=.tools/postgresql/pgsql/bin
PLAYWRIGHT_BROWSERS_PATH=.local/playwright
NEXT_TELEMETRY_DISABLED=1
